<Configuration>

  <Add OfficeClientEdition="64" Channel="Monthly">
    <Product ID="O365ProPlusRetail">
      <Language ID="en-us" />
    </Product>
  </Add>

  <!-- Shared Computer Activation for shared environments like virtual desktops -->
  <Property Name="SharedComputerLicensing" Value="1" />

  <!-- Set display level to none for silent install and accept the EULA -->
  <Display Level="None" AcceptEULA="TRUE" /> 

  <!-- Uncomment if you want auto-activation -->
  <!-- <Property Name="AUTOACTIVATE" Value="1" /> -->

</Configuration>
